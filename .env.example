APP_NAME=GESTAVI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_gestavi
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
DB_DUMP_BINARY_PATH=

# SMS : log (défaut) | africastalking | orange
SMS_DRIVER=log
SMS_DEFAULT_COUNTRY_CODE=225
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=
ORANGE_SMS_SENDER_NAME=GESTAVI

# Mobile money : secrets HMAC des webhooks opérateurs (POST /api/webhooks/mobile-money/{operator})
ORANGE_MONEY_WEBHOOK_SECRET=
MTN_MOMO_WEBHOOK_SECRET=
MOOV_MONEY_WEBHOOK_SECRET=
WAVE_WEBHOOK_SECRET=
MOBILE_MONEY_MATCH_TOLERANCE=1
MOBILE_MONEY_AUTO_MATCH_MIN_AGE=10

# Ledger : ancrage hors base de la chaîne de hachage (disque distant recommandé en production)
LEDGER_ANCHOR_DISK=local
LEDGER_ANCHOR_PATH=ledger

# Météo (OpenWeatherMap, gratuit jusqu'à 1 000 appels/jour) ; vide = fonctionnalité désactivée
OPENWEATHERMAP_API_KEY=

# Exports de rapports : disque « local » (route signée) ou « s3 » (MinIO : URL temporaire du bucket)
EXPORTS_DISK=local
# MinIO (compatible S3) : renseigner les variables AWS_* ci-dessus avec
#   AWS_ENDPOINT=http://127.0.0.1:9000  AWS_USE_PATH_STYLE_ENDPOINT=true  AWS_BUCKET=gestavi
#   AWS_URL=http://127.0.0.1:9000/gestavi (adresse publique du bucket pour les liens)
AWS_ENDPOINT=
AWS_URL=
